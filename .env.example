# Antigravity Manager Configuration
PORT=39200
HOST=127.0.0.1
NODE_ENV=production

# Telemetry & Polling Settings (Milliseconds)
POLL_INTERVAL_MS=5000
SLOW_DISCOVERY_INTERVAL_MS=60000

# Router Settings
ROUTER_DEFAULT_MODE=SHADOW
ROUTER_SWITCH_THRESHOLD=10
ROUTER_RETURN_THRESHOLD=30
ROUTER_MIN_DWELL_MINUTES=15
ROUTER_COOLDOWN_MINUTES=30
ROUTER_RESET_GRACE_MINUTES=5
